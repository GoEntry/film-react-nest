# Используем Node.js 20 на Alpine Linux для современной версии Node и минимального размера образа
FROM node:20-alpine as build

# Устанавливаем рабочую директорию внутри контейнера
WORKDIR /app

# Копируем только файлы package.json и package-lock.json для кэширования зависимостей
COPY package*.json ./

# Устанавливаем зависимости с использованием чистой установки
RUN npm ci

# Копируем все файлы проекта в контейнер
COPY . .

# Запускаем сборку проекта для создания оптимизированной продакшн-версии
RUN npm run build

# Команда для запуска приложения в продакшн режиме
CMD ["npm", "run", "start:prod"]